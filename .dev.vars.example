# ====================================================================
# TEMPLATE .dev.vars — copy jadi .dev.vars, lalu isi nilai kamu.
#   cp .dev.vars.example .dev.vars
# JANGAN commit .dev.vars ke git! (sudah di .gitignore)
# Legenda tiap baris: [WAJIB] bot tidak jalan tanpa ini
#   [OPSIONAL] boleh kosong | [VIA BOT] jangan isi di sini, isi via panel admin
# ====================================================================

# --- 1. WAJIB: Telegram ---
# Ambil token dari @BotFather. Buat BOT TERPISAH untuk dev, jangan pakai token production.
# [WAJIB]
BOT_TOKEN=isi-token-bot-dev-di-sini

# ID Telegram numerik owner. Cek via @userinfobot (bukan username, harus angka).
# [WAJIB]
OWNER_ID=6242090623

# Username owner TANPA @ (contoh: andxinn). Dipakai untuk link "chat owner".
# [OPSIONAL]
OWNER_USN=

# Set 'true' kalau token di atas adalah token PRODUCTION.
# Dev-server tampilkan warning besar saat startup agar tidak salah kirim ke bot live.
# [OPSIONAL]
IS_PROD_TOKEN=false

# --- 2. Identitas toko (bisa diubah kapan saja via panel bot) ---
# Admin → Sistem → Identitas & Info. Nilai di sini = default awal.
# [OPSIONAL]
NAMA_BOT=DEV STORE BOT
STORE_NAME=DEV STORE
# Username CS TANPA @, tampil di pesan bantuan. Kosongkan bila belum ada.
# [OPSIONAL]
CS=
# Link/username channel katalog (contoh: @katalogkamu). Kosongkan bila belum ada.
# [OPSIONAL]
CHANNEL_STORE=

# --- 3. Channel & log (isi setelah bikin channel/grup, format -100...) ---
# Log semua transaksi sukses/gagal. Admin → Sistem → Channel & Log.
# [OPSIONAL]
CHANNEL_LOG=
INVOICE_LOGGER=
# Tempat file backup DB otomatis dikirim.
# [OPSIONAL]
CHANNEL_BACKUP=
# Jam backup otomatis harian (WIB, 0-23).
# [OPSIONAL]
JAM_BACKUP=6

# --- 4. Database ---
# auto = ikut setting bot (Admin → Sistem → Kelola Database)
# kv = paksa lokal (dev-db.json) | turso = paksa Turso
# [OPSIONAL]
DB_MODE=auto

# Kredensial Turso via env (menang atas setting bot). Cara utama tetap via panel bot.
# Format URL: libsql://namadb-xxx.turso.io (dari dashboard turso.tech → database → Connect)
# [OPSIONAL]
#TURSO_URL=libsql://xxx.turso.io
#TURSO_TOKEN=

# --- 5. Mode & simulasi (dev saja) ---
# development | production (dev-server otomatis pakai 'development')
# [OPSIONAL]
MODE=development
# 'true' = semua payment langsung sukses (skip gateway). Untuk uji alur tanpa bayar.
# [OPSIONAL]
SIMULATE_PAYMENT=false
SIMULATE_DELAY=5
# Auth endpoint /dev/* (min 8 karakter acak). Kosongkan = endpoint dev terbuka di localhost.
# [OPSIONAL]
#DEV_TOKEN=
# Rahasia webhook Telegram production. Dev tidak perlu.
# [OPSIONAL]
#WEBHOOK_SECRET=

# --- 6. Banner (opsional, bisa via panel bot: Sistem → Media & Banner) ---
# File ID foto Telegram untuk banner. '-' = tanpa banner.
# [OPSIONAL]
BANNER_FILE_ID=-

# ====================================================================
# JANGAN ISI — VIA PANEL BOT (Admin → Pembayaran / Sistem)
# ====================================================================
# Payment (Pakasir/Duitku/Saweria): slug, API key, mode, metode, fee
#   → Admin → Pembayaran → pilih gateway
# Kredensial Turso (cara utama): URL + token
#   → Admin → Sistem → Kelola Database
# DATA_QRIS / QR_STRING: legacy, tidak dipakai lagi (v9update13+).
