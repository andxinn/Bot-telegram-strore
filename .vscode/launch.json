{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Dev Server (watch + debug)",
      "program": "${workspaceFolder}/dev-server.mjs",
      "runtimeArgs": [
        "--watch",
        "--watch-path=./src",
        "--watch-path=./dev-server.mjs"
      ],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": { "NODE_ENV": "development" }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Dev Server (once, no watch)",
      "program": "${workspaceFolder}/dev-server.mjs",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": { "NODE_ENV": "development" }
    }
  ]
}
