{
  "name": "telegram-store-bot",
  "version": "9.19.0",
  "description": "Telegram Store Bot for Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=./src --watch-path=./dev-server.mjs dev-server.mjs",
    "dev:once": "node dev-server.mjs",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir=.wrangler/dry",
    "tail": "wrangler tail",
    "start": "wrangler dev",
    "kv:snap": "node scripts/kv-snap.mjs save",
    "kv:list": "node scripts/kv-snap.mjs list",
    "kv:load": "node scripts/kv-snap.mjs load"
  },
  "engines": {
    "node": ">=18.11.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
